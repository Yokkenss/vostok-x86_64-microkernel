struct Point {
    x: i64,
    y: i64,
}

fn translate(point: *mut Point, dx: i64, dy: i64) -> void {
    (*point).x = (*point).x + dx;
    (*point).y = (*point).y + dy;
}

pub fn main() -> i32 {
    var point: Point = Point { x: 10, y: 20 };
    translate(&mut point, 5, -5);

    if point.x == 15 && point.y == 15 {
        return 0;
    }
    return 1;
}
