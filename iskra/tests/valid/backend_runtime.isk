fn nested(value: i64) -> i64 {
    return value + 1;
}

fn add(left: i64, right: i64) -> i64 {
    return left + right;
}

pub fn main() -> i32 {
    let wrapped: u8 = 255 + 1;
    if wrapped != 0 {
        return 1;
    }

    if -1 >= 0 {
        return 2;
    }

    if add(20, nested(21)) != 42 {
        return 3;
    }

    return 0;
}
